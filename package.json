{
  "name": "prayer-tower",
  "private": true,
  "description": "Prayer Tower: server, app and shared code in one repo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:start": "supabase start -x studio,imgproxy,logflare,vector,supavisor,edge-runtime",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "dev:api": "npm run dev:api -w @prayer-tower/server",
    "dev:worker": "npm run dev:worker -w @prayer-tower/server",
    "dev:mobile": "npm run start -w @prayer-tower/mobile",
    "grant-role": "npm run grant-role -w @prayer-tower/server --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test -w @prayer-tower/server && npm test -w @prayer-tower/station",
    "station": "npm run dev -w @prayer-tower/station",
    "seed:demo": "npm run seed:demo -w @prayer-tower/server --",
    "test:e2e": "npm test -w @prayer-tower/e2e",
    "brand": "node scripts/branding/render.mjs",
    "changelog": "node scripts/release/release.mjs changelog",
    "release": "node scripts/release/release.mjs release",
    "lint": "eslint . && npm run lint -w @prayer-tower/mobile",
    "knip": "knip",
    "coverage": "npm run coverage -w @prayer-tower/server"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "knip": "^6.43.0",
    "playwright": "^1.63.0",
    "supabase": "^2.122.0",
    "typescript-eslint": "^8.72.1"
  }
}
