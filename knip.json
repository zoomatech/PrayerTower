{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/i18n/*.ts"
      ]
    },
    "apps/mobile": {
      "entry": [
        "workbox-config.js",
        "src/widgets/*.tsx"
      ],
      "ignoreDependencies": [
        "expo-glass-effect"
      ]
    },
    "apps/server": {
      "entry": [
        "src/scripts/*.ts"
      ]
    },
    "apps/station": {
      "entry": [
        "scripts/*.ts",
        "src/burst/web.ts",
        "src/listener-main.ts"
      ]
    }
  },
  "ignoreExportsUsedInFile": true,
  "ignore": [
    "deploy/fly-web/site/**",
    "apps/mobile/src/lib/burst-decoder.generated.js"
  ],
  "ignoreBinaries": [
    "openssl"
  ]
}
