# Staging API and worker. Copy to deploy/staging.env (gitignored) and fill in
# the STAGING Supabase project's values. Never point staging at production.
# Run: ENV_FILE=deploy/staging.env API_PORT=3100 docker compose -p prayertower-staging up -d --build
DATABASE_URL=postgresql://postgres.<staging-ref>:<password>@<pooler-host>:5432/postgres
# Free and small plans have few connections; API + worker stay under it.
DATABASE_POOL_MAX=5
SUPABASE_URL=https://<staging-ref>.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
PORT=3000
CORS_ORIGINS=
# Push goes only to staging builds (their own Expo push tokens). Set 0 to send none.
PUSH_ENABLED=1
# Leave the station off unless a test station is attached.
STATION_API_KEY=
OPENAI_API_KEY=
SUPPORT_EMAIL=
CRISIS_COUNTRY=US
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0
METRICS_TOKEN=
LOG_LEVEL=debug
# Weekly digest email; leave empty on staging unless testing it.
SMTP_URL=
MAIL_FROM=
