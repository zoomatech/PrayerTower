# HTTPS for the API and the web app on one server (compose.yml). Caddy gets and
# renews both certificates itself once DNS points here and ports 80 and 443 are
# open. Without a domain, sslip.io names work: api.203-0-113-5.sslip.io resolves
# to 203.0.113.5 (https://sslip.io).
{$API_HOST} {
	encode zstd gzip
	# The metrics endpoint stays off the internet (docs/DEPLOY.md → Monitoring).
	@metrics path /metrics
	respond @metrics 404
	reverse_proxy api:3000 {
		header_up X-Real-IP {remote_host}
	}
}

# The web app (PWA), as deploy/fly-web/Caddyfile serves it on Fly.io.
{$WEB_HOST} {
	root * /srv
	encode zstd gzip
	@fresh path /sw.js /index.html /manifest.json
	header @fresh Cache-Control "no-cache"
	@hashed path /_expo/static/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}
