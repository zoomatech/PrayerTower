# Serves the single-page web app. Every unknown path gets index.html so links
# like /post/<id> open in the app. sw.js and index.html are never cached by the
# browser, so a new build reaches testers on their next visit.
:8080 {
	root * /srv
	encode zstd gzip
	@fresh path /sw.js /index.html /manifest.json
	header @fresh Cache-Control "no-cache"
	@hashed path /_expo/static/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}
