# Production settings for scripts/go-live.sh. Copy to deploy/production.env
# (gitignored) and fill in. Server values become Fly secrets (or Render env
# vars); EXPO_PUBLIC_* values are built into the web app and are not secret.
# Every setting: apps/server/.env.example and docs/DEVELOPER_HANDOFF.md.

# --- Supabase Cloud project (Project Settings → Database / API keys) ---
SUPABASE_PROJECT_REF=
# Database password, used only by the Supabase CLI to push migrations. Not sent to Fly.
SUPABASE_DB_PASSWORD=
# Personal access token (supabase.com/dashboard/account/tokens), used only by
# go-live.sh to turn on the invite-code Auth hook. Not sent to Fly. Optional:
# without it, the script tells you to turn the hook on in the Dashboard.
SUPABASE_ACCESS_TOKEN=
# Session pooler connection string (port 5432), from the project's Connect panel.
DATABASE_URL=postgresql://postgres.<ref>:<password>@<pooler-host>:5432/postgres
DATABASE_POOL_MAX=5
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# --- API ---
# The web app's address, so the browser may call the API (comma-separated).
CORS_ORIGINS=https://prayertower-web.fly.dev
PUSH_ENABLED=1
EXPO_ACCESS_TOKEN=
SUPPORT_EMAIL=
CRISIS_COUNTRY=US
STATION_API_KEY=
SENTRY_DSN=
METRICS_TOKEN=
# Staff password for the API docs at /api/docs in production (HTTP Basic, any user name; 16+ characters).
# Unset: production serves only /api/openapi.json, and only to admins' and moderators' bearer tokens.
API_DOCS_PASSWORD=

# --- Moderation (off until a key is set) ---
MODERATION_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Email (weekly digest, sponsor report) ---
SMTP_URL=
MAIL_FROM=
SPONSOR_REPORT_TO=
# Language of the sponsor report for addresses that aren't members (en or es). Members get their app
# language; write an address as es:name@org to choose for one person.
SPONSOR_REPORT_LANG=en
# The web app's address. Invite emails link to <WEB_APP_URL>/sign-in?invite=CODE when it is set.
WEB_APP_URL=

# --- Web app (PWA) build ---
EXPO_PUBLIC_API_URL=https://prayertower-api.fly.dev
EXPO_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_PRIVACY_URL=https://prayertower-api.fly.dev/privacy

# --- Fly.io app names (change if taken) ---
FLY_API_APP=prayertower-api
FLY_WEB_APP=prayertower-web
FLY_ORG=personal
