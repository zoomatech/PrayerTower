# Prayer Tower listener node settings. install.sh --listener copies this to
# /etc/prayer-tower-listener.env. After editing:
#   sudo systemctl restart prayer-tower-listener
PRAYER_TOWER_API_URL=https://api.example.org
# The node key from Admin → Radio → Listener nodes → Add (shown once).
NODE_KEY=
# The receiver's sound card. List them with `arecord -l`, then e.g.:
# LISTEN_RECORD_CMD=arecord -q -t raw -f S16_LE -r 48000 -c 1 -D plughw:CARD=Device,DEV=0
# From an HF (SSB) receiver, allow for tuning up to 50 Hz off (slower):
# LISTEN_SEARCH_HZ=50
# Or an RTL-SDR USB dongle instead of a radio (install with --sdr). rtl_fm tunes it,
# and LISTEN_RECORD_CMD is then ignored. The frequency is the station's, in Hz or with
# k/M. FM by default; LISTEN_SDR_MODE=usb for HF SSB (below 24 MHz the dongle also
# needs LISTEN_SDR_DIRECT=on, or an upconverter). Gain is auto unless set in dB;
# LISTEN_SDR_PPM corrects the dongle's frequency error; LISTEN_SDR_DEVICE picks a dongle.
# LISTEN_SOURCE=rtlsdr
# LISTEN_SDR_FREQ=146.52M
# LISTEN_SDR_MODE=fm
# LISTEN_SDR_GAIN=auto
# LISTEN_SDR_PPM=0
# LISTEN_SDR_DEVICE=0
# LISTEN_SDR_DIRECT=off
LISTEN_DECODE_SECONDS=6
# "Heard" receipts for senders (fingerprints only; needs receipts on in Admin → Radio).
LISTEN_RECEIPTS=on
# Also read prayer panels the station sends as SSTV pictures (BURST_MODE=sstv), and report
# them as heard like bursts. Uses more of the Pi's processor. on or off.
LISTEN_SSTV=off
# Coverage map (Admin → Radio), opt-in: where this listener is, as "lat,lon" or
# "lat,lon,Place name". Rounded to 0.1 degree (about a city) before it is sent.
# Leave it empty to share nothing.
NODE_LOCATION=
# Sign each report with NODE_KEY instead of sending the key (recommended once the
# server supports it; Admin → Radio can then require signed reports). on or off.
LISTEN_SIGN=off
# Store-and-forward relay (docs/RADIO_BURST.md, "Store-and-forward relay"): this node
# re-sends the bursts it decodes, under its own call sign, to reach listeners beyond the
# station. Off unless RELAY=on. Needs a transmitter wired like a station's (sound card
# and PTT) and a licensed control operator. Start with RELAY_MODE=simulate.
RELAY=off
# RELAY_CALL_SIGN=K1RLY
# RELAY_FROM=N0CALL
# RELAY_MAX_HOPS=1
# RELAY_MAX_SECONDS_PER_HOUR=120
# RELAY_DELAY_MS=1000
# RELAY_MODE=simulate
# RELAY_PLAY_CMD=aplay -q -D plughw:1,0 {wav}
# RELAY_PTT_ON_CMD=rigctl -m 2 T 1
# RELAY_PTT_OFF_CMD=rigctl -m 2 T 0
