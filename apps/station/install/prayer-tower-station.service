# Prayer Tower radio station worker. Installed by install.sh; see docs/RADIO_STATION_INSTALL.md.
[Unit]
Description=Prayer Tower radio station worker
Documentation=https://github.com/zoomatech/PrayerTower/blob/main/docs/RADIO_STATION_INSTALL.md
Wants=network-online.target
After=network-online.target
# Give up after 5 crashes in 10 minutes rather than looping forever.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=prayer-station
Group=prayer-station
EnvironmentFile=/etc/prayer-tower-station.env
ExecStart=/usr/bin/node /opt/prayer-tower-station/dist/src/main.js
WorkingDirectory=/opt/prayer-tower-station
StateDirectory=prayer-tower-station
# Restart after a crash or a lost network, but never after a failed transmission
# (exit 3): transmit is already off, and a person must check the radio first.
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=3
# The worker only talks HTTP to the API, to fldigi and to rigctld on this machine.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Burst mode (BURST_MODE=audio) plays through the sound card: the only device
# it may open is ALSA's /dev/snd (docs/STATION_OPERATOR_GUIDE.md).
DevicePolicy=closed
DeviceAllow=char-alsa rw
SupplementaryGroups=audio
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes

[Install]
WantedBy=multi-user.target
