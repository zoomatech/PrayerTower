# Hamlib rigctld settings for the Prayer Tower station. install.sh --hamlib copies
# this to /etc/prayer-tower-rigctld.env. After editing:
#   sudo systemctl restart prayer-tower-rigctld prayer-tower-station
#
# RIG_MODEL is the Hamlib model number of your radio: list them with `rigctl -l`.
# 1 is Hamlib's dummy radio, a PLACEHOLDER that needs no radio, so everything
# can be tested first. Replace it with your radio's number.
RIG_MODEL=1
# The radio's CAT port, e.g. /dev/ttyUSB0 (or /dev/serial/by-id/... so it never moves).
RIG_DEVICE=
# Serial speed set in the radio's menu, e.g. 19200. Empty uses the radio's fastest.
RIG_SPEED=
RIG_PORT=4532
# Anything else rigctld takes, e.g. --set-conf=serial_handshake=None
RIG_EXTRA_ARGS=
