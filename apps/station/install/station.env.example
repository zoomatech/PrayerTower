# Prayer Tower radio station settings. install.sh copies this to
# /etc/prayer-tower-station.env (readable by root and the station only).
# After editing: sudo systemctl restart prayer-tower-station
PRAYER_TOWER_API_URL=https://api.example.org
# The STATION_API_KEY set on the Prayer Tower server (openssl rand -hex 32).
STATION_API_KEY=
# Your amateur call sign. Use N0CALL only with a dummy load.
CALL_SIGN=N0CALL
FLDIGI_URL=http://127.0.0.1:7362/RPC2
MODEM=BPSK31
POLL_SECONDS=10
TX_TIMEOUT_SECONDS=180
MAX_PIECE_CHARS=500
# BLOCKLIST_FILE=/etc/prayer-tower-station-blocklist.txt
# Burst mode (docs/RADIO_BURST.md): many prayers compressed into one short
# burst. off | audio | fldigi | simulate | packet. Try simulate first.
# packet: short IDs and counts as 1200-baud APRS packets, for a radio that can't
# carry the bursts (docs/RADIO_BURST.md, Packet fallback). Needs Admin -> Radio ->
# "Packet fallback" on. PACKET_PATH lists digipeaters to ask; empty asks none.
# PACKET_PATH=WIDE1-1
BURST_MODE=off
BURST_PRESET=fm-standard
# BURST_PRESET=auto picks from a receiver's channel report (docs/RADIO_BURST.md, Auto preset):
# BURST_AUTO_REPORT=/var/lib/prayer-tower-station/bursts/channel.json
# BURST_AUTO_PRESETS=fm-robust-fec,fm-standard,fm-fast,fm-turbo-fec,fm-turbo
# BURST_AUTO_MARGIN_DB=3
# On HF (shortwave SSB) use the hf- presets (docs/RADIO_BURST.md, HF presets), e.g.
# BURST_PRESET=hf-robust, or auto with BURST_AUTO_PRESETS=hf-robust,hf-standard,hf-fast
# and BURST_AUTO_MARGIN_DB=6. Simulate mode through a fading HF path: BURST_SIM_HF=moderate
BURST_MAX_PRAYERS=50
# Compression v2 (codec 4, docs/RADIO_BURST.md): bursts about 5-10% shorter. Turn on only
# after every listener node, the app and /listen are updated.
# BURST_CODEC_V2=on
# BURST_PLAY_CMD=aplay -q -D plughw:1,0 {wav}
# BURST_PTT_ON_CMD=rigctl -m 2 T 1
# BURST_PTT_OFF_CMD=rigctl -m 2 T 0
# Rig control through Hamlib rigctld (install.sh --hamlib; docs/STATION_OPERATOR_GUIDE.md, Rig control):
# sets the frequency and mode at start and keys PTT for burst audio, checking the radio really keyed.
RIG_CONTROL=off
# RIG_HOST=127.0.0.1
# RIG_PORT=4532
# RIG_FREQ_HZ=145050000
# RIG_MODE=FM
# RIG_PASSBAND_HZ=0
# The frequency written to the operator log when RIG_FREQ_HZ is not set (Hz).
# STATION_FREQ_HZ=146520000
# Automatic station ID (docs/STATION_OPERATOR_GUIDE.md, Station ID): the call sign in
# Morse code after a burst, the first time and then every STATION_ID_MINUTES.
STATION_ID=off
# STATION_ID_MINUTES=10
# STATION_ID_WPM=20
# STATION_ID_TONE_HZ=800
