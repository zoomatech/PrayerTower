# Prayer Tower radio station settings. install.sh copies this to
# /etc/prayer-tower-station.env (readable by root and the station only).
# After editing: sudo systemctl restart prayer-tower-station
PRAYER_TOWER_API_URL=https://api.example.org
# The STATION_API_KEY set on the Prayer Tower server (openssl rand -hex 32).
STATION_API_KEY=
# Your amateur call sign. Use N0CALL only with a dummy load.
CALL_SIGN=N0CALL
FLDIGI_URL=http://127.0.0.1:7362/RPC2
MODEM=BPSK31
POLL_SECONDS=10
TX_TIMEOUT_SECONDS=180
MAX_PIECE_CHARS=500
# BLOCKLIST_FILE=/etc/prayer-tower-station-blocklist.txt
