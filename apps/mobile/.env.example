# Copy to .env. EXPO_PUBLIC_ values are bundled into the app, so never put secrets here.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The publishable key from `npx supabase status` (safe to ship in the app).
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Published privacy policy and terms of use (drafts in docs/legal/)
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
# Crisis line shown on posts that mention suicide or self-harm: US (988, default), CA (9-8-8), GB or IE (Samaritans 116 123).
EXPO_PUBLIC_CRISIS_COUNTRY=US
# Crash reporting (Sentry); unset = off. If set, add Crash Data to the store privacy answers.
EXPO_PUBLIC_SENTRY_DSN=
