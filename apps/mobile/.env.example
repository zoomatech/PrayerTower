# Copy to .env. EXPO_PUBLIC_ values are bundled into the app, so never put secrets here.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The publishable key from `npx supabase status` (safe to ship in the app).
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Published privacy policy and terms of use (drafts in docs/legal/)
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
