{
  "expo": {
    "name": "Prayer Tower",
    "slug": "prayer-tower",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "prayertower",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zoomatech.prayertower",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.zoomatech.prayertower",
      "adaptiveIcon": {
        "backgroundColor": "#5B3E96",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#5B3E96",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5B3E96",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "./plugins/with-mac-designed-for-ipad",
      "./plugins/with-app-links",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Prayer Tower to add your photos and videos to prayer posts."
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en"
          ]
        }
      ],
      [
        "expo-widgets",
        {
          "enablePushNotifications": true,
          "widgets": [
            {
              "name": "PrayNow",
              "displayName": "Pray Now",
              "description": "The next prayer request to pray for.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "PrayNow",
              "label": "Pray now",
              "description": "The next prayer request to pray for.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to record the spoken prayers and voice notes you choose to send, and to hear radio prayer bursts when you tap Start listening.",
          "recordAudioAndroid": false
        }
      ],
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
