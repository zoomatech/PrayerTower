{
  "name": "@prayer-tower/mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/ui": "~58.0.24",
    "@prayer-tower/shared": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~8.28.0",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~58.0.20",
    "expo-audio": "~58.0.10",
    "expo-constants": "~58.0.13",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-glass-effect": "~58.0.5",
    "expo-iap": "6.3.0",
    "expo-image": "~58.0.17",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.27",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.18",
    "expo-video": "~58.0.12",
    "expo-web-browser": "~58.0.7",
    "expo-widgets": "~58.0.24",
    "i18n-js": "^4.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-android-widget": "^0.25.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "globals": "^16.5.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.12",
    "typescript": "~6.0.3",
    "workbox-build": "^7.4.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web && node web-edition.js && node workbox-config.js",
    "test": "jest"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts?(x)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@prayer-tower/.*)"
    ]
  }
}
