# Postgres connection used by the API and worker (local: `npx supabase status`).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Supabase project URL (Auth JWKS, Storage).
SUPABASE_URL=http://127.0.0.1:54321
# Server-only secret key, used for Storage signed upload URLs. Never ship to clients.
SUPABASE_SECRET_KEY=
PORT=3000
# Optional: AI flagging via OpenAI omni-moderation-latest. Unset = no AI flags.
OPENAI_API_KEY=
# Radio station worker key (at least 24 characters; generate with: openssl rand -hex 32). Unset = no station.
STATION_API_KEY=
# Optional: Expo push access token (only if enhanced push security is on).
EXPO_ACCESS_TOKEN=
# Set to 0 to disable sending push (in-app notifications are still written).
PUSH_ENABLED=1
# Browser origins allowed to call the API (comma-separated). Empty = any, for development only.
CORS_ORIGINS=
