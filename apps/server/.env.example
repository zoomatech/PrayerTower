# Postgres connection used by the API and worker (local: `npx supabase status`).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Postgres connections per process (default 10). Hosted Supabase limits total connections by plan; keep API + worker under it.
DATABASE_POOL_MAX=10
# Supabase project URL (Auth JWKS, Storage).
SUPABASE_URL=http://127.0.0.1:54321
# Server-only secret key, used for Storage signed upload URLs. Never ship to clients.
SUPABASE_SECRET_KEY=
PORT=3000
# Optional: AI flagging via OpenAI omni-moderation-latest. Unset = no AI flags.
OPENAI_API_KEY=
# Who checks new text for safety: openai (OPENAI_API_KEY), claude (ANTHROPIC_API_KEY),
# local (LOCAL_MODEL_URL, an Ollama server on your own Mac; docs/LOCAL_MODERATION.md) or off.
# Without the chosen provider's key, the AI check is off and only member reports reach moderators.
MODERATION_PROVIDER=openai
ANTHROPIC_API_KEY=
MODERATION_CLAUDE_MODEL=claude-opus-5-5
LOCAL_MODEL_URL=
LOCAL_MODERATION_MODEL=gpt-oss:20b
# Token purchase (App Store). Also needs Admin purchases switch on. See docs/TOKEN_PURCHASE.md.
# APPLE_IAP_ENVIRONMENT=Sandbox
# APPLE_APP_APPLE_ID=
# APPLE_BUNDLE_ID=com.zoomatech.prayertower
# APPLE_ROOT_CA_PATHS=/app/certs/AppleRootCA-G3.cer
# Live rooms on Jitsi as a Service (8x8), the paid video option. See docs/LIVE_VIDEO.md. All three unset = not used.
# JAAS_APP_ID=vpaas-magic-cookie-0000000000000000
# JAAS_API_KEY_ID=vpaas-magic-cookie-0000000000000000/000000
# JAAS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Before any of these keys is set, Admin → Practice mode lets AI, live rooms and token purchases be tried (docs/PRACTICE_MODE.md).
# Radio station worker key (at least 24 characters; generate with: openssl rand -hex 32). Unset = no station.
STATION_API_KEY=
# Optional: Expo push access token (only if enhanced push security is on).
EXPO_ACCESS_TOKEN=
# Expo push service; set to a stand-in (e.g. http://127.0.0.1:4010) to test pushes without devices.
# EXPO_PUSH_BASE_URL=https://exp.host
# Set to 0 to disable sending push (in-app notifications are still written).
PUSH_ENABLED=1
# Browser origins allowed to call the API (comma-separated). Empty = any, for development only.
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=300
# Behind a proxy, the header holding the visitor's address (fly.toml sets fly-client-ip).
# CLIENT_IP_HEADER=fly-client-ip
# Public account-deletion page (/account-deletion): the publishable key lets people sign in there and delete; SUPPORT_EMAIL is shown as the contact.
SUPABASE_PUBLISHABLE_KEY=
SUPPORT_EMAIL=
# Crisis line named in removal notices (match EXPO_PUBLIC_CRISIS_COUNTRY in the app): US, CA, GB or IE.
CRISIS_COUNTRY=US
# Public website (/, /support, /privacy, /terms). SITE_LEGAL_DIR defaults to docs/legal; the reviewed PRIVACY_POLICY.md / TERMS_OF_USE.md win over the _DRAFT files.
# SITE_LEGAL_DIR=
# Store links shown on the landing page once listed.
APP_STORE_URL=
PLAY_STORE_URL=
# Open Circle's own website (docs/OPEN_CIRCLE.md): its hostnames get its pages at the root; they are always at /open-circle.
# OPEN_CIRCLE_HOSTS=opencircle.example.com
# OPEN_CIRCLE_NAME=Open Circle
# OPEN_CIRCLE_APP_STORE_URL=
# OPEN_CIRCLE_SUPPORT_EMAIL=
# Shared links open the app (docs/APP_LINKS.md). Apple Team ID from developer.apple.com > Membership;
# Android fingerprints from `eas credentials -p android` and Play Console > App integrity (comma-separated).
# Made admin once they sign up and confirm their email (comma-separated).
ADMIN_EMAILS=
APPLE_TEAM_ID=
# Apple push key for the Lock Screen "Praying for you now" Live Activity (docs/GROWTH.md). Unset = no live updates.
APNS_KEY_ID=
APNS_PRIVATE_KEY=
# APNS_PRODUCTION=false
# Text messages for prayer-chain numbers (Twilio; docs/GROWTH.md). Unset = no texts.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ANDROID_CERT_SHA256=
# APP_LINK_APP_IDS=com.zoomatech.prayertower,com.zoomatech.prayertower.staging
# Error reporting (src/instrument.ts); unset = off. Never sends bodies, users, headers or query values.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0
# GET /metrics for Prometheus, with "Authorization: Bearer <token>" (24+ characters); unset = no endpoint.
METRICS_TOKEN=
# Staff password for the API docs at /api/docs in production (HTTP Basic, any user name; 16+ characters).
# Unset: production serves only /api/openapi.json, and only to admins' and moderators' bearer tokens.
API_DOCS_PASSWORD=
# LOG_LEVEL=info
# Outgoing email for the weekly digest (members opt in under Me → Weekly email). Any SMTP provider works,
# e.g. smtps://resend:<api key>@smtp.resend.com:465. Unset = no digest emails.
SMTP_URL=
MAIL_FROM=
# Emails (comma-separated) that get the pilot report every Monday 08:00 UTC. Needs SMTP_URL.
SPONSOR_REPORT_TO=
# Language of the sponsor report for addresses that aren't members (en or es). Members get their app
# language; write an address as es:name@org to choose for one person.
SPONSOR_REPORT_LANG=en
# The app is English only. 1 brings back Spanish notifications, emails and /es pages.
SPANISH_ENABLED=
# The web app's address. Invite emails link to <WEB_APP_URL>/sign-in?invite=CODE when it is set.
WEB_APP_URL=

# Data retention (worker, daily at 03:30 UTC). Days; 0 turns that purge off.
# Text and photos of content moderators removed (pending appeals are kept):
RETENTION_REMOVED_DAYS=90
RETENTION_NOTIFICATION_DAYS=90
# Handled website deletion requests, dead push tokens, finished scheduled gifts:
RETENTION_QUEUE_DAYS=30
# Cross-posting from Facebook and Threads (docs/CROSSPOST.md; off until Admin → Notebook ideas turns it on).
# The browser extension needs none of these. "Connect Threads"/"Connect Facebook" need the public URL,
# the token key (any random text, 32+ characters) and that provider's Meta app ID and secret.
CROSSPOST_PUBLIC_URL=
CROSSPOST_TOKEN_KEY=
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# FACEBOOK_GRAPH_VERSION=v26.0
