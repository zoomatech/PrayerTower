{"books":[{"id":"1193","title":"Dhammapada","description":"The Dhammapada is is a Buddhist scripture, containing 423 verses in 26 categories. According to tradition, these are verses spoken by the Buddha on various occasions, most of which deal with ethics. It is is considered one of the most important pieces of Theravada literature. Despite this, the Dhammapada is read by many Mahayana Buddhists and remains a very popular text across all schools of Buddhism. - Excerpted from Wikipedia","url_text_source":"https:\/\/www.gutenberg.org\/ebooks\/2017","language":"English","copyright_year":"1869","num_sections":"7","url_rss":"https:\/\/librivox.org\/rss\/1193","url_zip_file":"https:\/\/archive.org\/compress\/dhammapada_0707_librivox\/formats=64KBPS MP3&file=\/dhammapada_0707_librivox.zip","url_project":"https:\/\/en.wikipedia.org\/wiki\/Dhammapada","url_librivox":"https:\/\/librivox.org\/the-dhammapada-translated-by-f-max-mueller\/","url_other":"","totaltime":"1:42:34","totaltimesecs":6154,"authors":[{"id":"221","first_name":"","last_name":"Unknown","dob":"","dod":""}],"url_iarchive":"https:\/\/www.archive.org\/details\/dhammapada_0707_librivox","sections":[{"id":"140651","section_number":"1","title":"Section 1, Chapters 1-4","listen_url":"https:\/\/www.archive.org\/download\/dhammapada_0707_librivox\/dhammapada_01_muller_64kb.mp3","language":"English","playtime":"876","file_name":null,"readers":[{"reader_id":"1552","display_name":"Roger Turnau"}]},{"id":"140652","section_number":"2","title":"Section 2, Chapters 5-8","listen_url":"https:\/\/www.archive.org\/download\/dhammapada_0707_librivox\/dhammapada_02_muller_64kb.mp3","language":"English","playtime":"652","file_name":null,"readers":[{"reader_id":"1261","display_name":"M\u00e5ns Broo"}]},{"id":"140653","section_number":"3","title":"Section 3, Chapters 9-14","listen_url":"https:\/\/www.archive.org\/download\/dhammapada_0707_librivox\/dhammapada_03_muller_64kb.mp3","language":"English","playtime":"1156","file_name":nul