{
  "name": "@prayer-tower/server",
  "version": "0.1.0",
  "scripts": {
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:api": "node --import ./dist/src/instrument.js dist/src/server.js",
    "start:worker": "node --import ./dist/src/instrument.js dist/src/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "grant-role": "tsx src/scripts/grant-role.ts",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "review-account": "tsx src/scripts/review-account.ts",
    "push-test": "tsx src/scripts/push-test.ts",
    "mail-test": "tsx src/scripts/mail-test.ts",
    "check-config": "tsx src/scripts/check-config.ts",
    "query-audit": "tsx src/scripts/query-audit.ts",
    "load-test": "tsx src/scripts/load-test.ts",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@apple/app-store-server-library": "3.1.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@prayer-tower/shared": "*",
    "@sentry/node": "11.9.0",
    "@supabase/supabase-js": "^2.118.0",
    "fastify": "^5.12.7",
    "graphile-worker": "^0.18.0",
    "jose": "^6.2.13",
    "marked": "18.1.2",
    "nodemailer": "10.2.1",
    "pg": "^8.23.1",
    "prom-client": "15.1.3",
    "zod": "^4.6.7"
  },
  "private": true,
  "type": "module",
  "description": "Prayer Tower V1 API and worker",
  "engines": {
    "node": ">=22"
  }
}
